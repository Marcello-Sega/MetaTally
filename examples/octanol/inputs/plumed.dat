zeta: COMBINE ARG=a1,a2,a3,a4,a5,a6,a7 COEFFICIENTS=1,3,9,27,81,243,729 POWERS=1,1,1,1,1,1,1 PERIODIC=NO

zeta1: COMBINE ARG=zeta COEFFICIENTS=1 POWERS=1 PERIODIC=NO
zeta2: COMBINE ARG=zeta COEFFICIENTS=1 POWERS=1 PERIODIC=NO
zeta3: COMBINE ARG=zeta COEFFICIENTS=1 POWERS=1 PERIODIC=NO
